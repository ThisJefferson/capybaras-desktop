{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "Capybaras",
    "version":  "0.1.0",
    "identifier":  "com.capybaras.desktop",
    "build":  {
                  "frontendDist":  "../web"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "title":  "Capybaras",
                                    "width":  800,
                                    "height":  600,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "resources":  [
                                     "..\\sidecar\\dist\\sidecar.mjs"
                                 ]
               }
}
