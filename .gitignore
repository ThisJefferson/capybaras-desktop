# dependencies
node_modules/

# build output
dist/
build/
target/
*.tsbuildinfo

# secrets - never commit these
.env
.env.*
*.pem
*.key
secrets*.json

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# local scratch
tmp/

# spike runtime artefacts (the spike code is committed; its logs and pidfiles are not)
spikes/**/.*.log
spikes/**/.*.pid
spikes/**/.*.out*.txt
spikes/**/.*.err*.txt

# spike build artefacts (regenerate with the spike's build.ps1)
spikes/**/target/
spikes/**/*.msix
spikes/**/*.cer
spikes/**/*.exe

# sidecar bundle output (build with: npm run build:sidecar)
apps/desktop/sidecar/dist/

# generated CSS custom properties (build with: npm run build:tokens)
apps/desktop/web/tokens.css

# paper build artifacts (build with: docs/papers/build-pdf.ps1)
docs/papers/*.html
docs/papers/verify-render.png

# synthesis build artifacts (the parts in synthesis/ are the source of truth)
docs/papers/verify-*.png
docs/papers/ai-quantum-and-harm.md

# research and papers are NOT published from this repo
docs/papers/
docs/research/agentic-harm.md
docs/research/safe-agent-blueprint.md
