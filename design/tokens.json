{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "Capybaras",
    "version": "0.2.0",
    "generated": "2026-09-28",
    "note": "Source of truth for the interface. Run `npm run build:tokens` to emit CSS custom properties into apps/desktop/web/tokens.css. Colours come from BRAND.md sections 'Palette'; the neutral ramp and the status family are defined here. The status family was added by the 2026-09-28 polish pass: the interface had only .ok and .bad, and .bad re-used coral, which BRAND.md and D18 reserve for 'needs you'."
  },

  "color": {
    "brand": {
      "sand": { "value": "#FBF7F0", "role": "Base background. Copacabana sand." },
      "atlantic": { "value": "#0F5C63", "role": "Primary brand, primary buttons, wordmark." },
      "coral": { "value": "#F2705A", "role": "RESERVED. The 'needs you' state and nothing else." },
      "capy": { "value": "#8B6239", "role": "Mascot body." },
      "leaf": { "value": "#4E8C5A", "role": "Secondary accent, success." },
      "ink": { "value": "#161616", "role": "Body text. The black of the pavement." },
      "sky": { "value": "#CFE7E6", "role": "Surfaces, cards, dividers." }
    },

    "neutral": {
      "0":   { "value": "#FFFFFF", "role": "Raised surfaces." },
      "50":  { "value": "#F7F4EE", "role": "Near-white, warm." },
      "100": { "value": "#EDE9E1", "role": "Sunken surfaces, table stripes." },
      "200": { "value": "#D8D2C6", "role": "Subtle borders, dividers." },
      "300": { "value": "#B4AEA2", "role": "Disabled text, strong borders." },
      "400": { "value": "#8A8479", "role": "Muted text on light surfaces." },
      "500": { "value": "#6A655C", "role": "Secondary text." },
      "600": { "value": "#4A4640", "role": "Emphasised secondary text." },
      "700": { "value": "#2E2B27", "role": "Headings on cream." },
      "800": { "value": "#1F1D1A", "role": "Maximum contrast text." },
      "900": { "value": "#161616", "role": "Same as ink, for scale completeness." }
    },

    "status": {
      "caution": { "value": "#8A5A00", "role": "Attention, pending review, low balance. Deep sunset amber. Never coral." },
      "caution-surface": { "value": "#FBF1DE", "role": "Caution chip and banner background." },
      "danger": { "value": "#B3271E", "role": "Meaningful danger only: a stopped service, a failed call, a destructive action being contemplated." },
      "danger-surface": { "value": "#FBE9E7", "role": "Error banner background." },
      "info": { "value": "#4A4640", "role": "Informational and inactive. A neutral, not an accent." },
      "info-surface": { "value": "#F1EDE6", "role": "Neutral chip background." },
      "success-text": { "value": "#356240", "role": "Success as TEXT at body size: leaf itself is 3.7:1 on sand and fails the 4.5:1 floor." }
    },

    "semantic": {
      "surface": {
        "base":     { "ref": "color.brand.sand" },
        "raised":   { "ref": "color.neutral.0" },
        "sunken":   { "ref": "color.neutral.100" },
        "accent":   { "ref": "color.brand.sky" },
        "inset":    { "ref": "color.neutral.50" },
        "scrim":    { "value": "rgba(22, 22, 22, 0.42)" }
      },
      "text": {
        "primary":   { "ref": "color.brand.ink" },
        "secondary": { "ref": "color.neutral.500" },
        "muted":     { "ref": "color.neutral.400" },
        "onAccent":  { "ref": "color.neutral.0" },
        "danger":    { "ref": "color.status.danger" },
        "caution":   { "ref": "color.status.caution" },
        "success":   { "ref": "color.status.success-text" }
      },
      "border": {
        "subtle": { "ref": "color.neutral.200" },
        "strong": { "ref": "color.neutral.300" },
        "focus":  { "ref": "color.brand.atlantic" },
        "danger": { "ref": "color.status.danger" }
      },
      "state": {
        "needsYou": { "ref": "color.brand.coral", "role": "Reserved. One meaning, one place." },
        "success":  { "ref": "color.brand.leaf" },
        "primary":  { "ref": "color.brand.atlantic" },
        "mascot":   { "ref": "color.brand.capy" },
        "caution":  { "ref": "color.status.caution" },
        "danger":   { "ref": "color.status.danger" },
        "info":     { "ref": "color.status.info" }
      }
    }
  },

  "typography": {
    "family": {
      "ui":     { "value": "system-ui, -apple-system, 'Segoe UI Variable Text', 'Segoe UI', sans-serif" },
      "display":{ "value": "system-ui, -apple-system, 'Segoe UI Variable Display', 'Segoe UI', sans-serif" },
      "mono":   { "value": "ui-monospace, 'Cascadia Mono', Consolas, monospace" }
    },
    "size": {
      "2xs": { "value": "11px", "role": "Caps status labels and captions. The floor of the ramp." },
      "xs":  { "value": "12px", "role": "Helper text, footnotes." },
      "sm":  { "value": "13px", "role": "Labels, secondary metadata, code." },
      "md":  { "value": "14px", "role": "Dense data and controls." },
      "lg":  { "value": "16px", "role": "BODY. BRAND.md section 5 sets 16px as the minimum body size." },
      "xl":  { "value": "20px", "role": "Section headings, stat figures." },
      "2xl": { "value": "24px", "role": "Card headline, page title." },
      "3xl": { "value": "32px", "role": "Display: the wordmark, and product-level moments." }
    },
    "lineHeight": {
      "tight": { "value": "1.2" },
      "snug":  { "value": "1.35" },
      "normal":{ "value": "1.5" },
      "loose": { "value": "1.7" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium":  { "value": "500" },
      "semibold":{ "value": "600" },
      "bold":    { "value": "700" }
    },
    "tracking": {
      "none": { "value": "0" },
      "caps": { "value": "0.08em", "role": "Uppercase labels: caps need more air than lowercase." },
      "display": { "value": "-0.015em", "role": "Large text needs less: optical correction at display sizes." }
    }
  },

  "space": {
    "0":  { "value": "0" },
    "1":  { "value": "4px" },
    "2":  { "value": "8px" },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
    "5":  { "value": "20px" },
    "6":  { "value": "24px" },
    "8":  { "value": "32px" },
    "10": { "value": "40px" },
    "12": { "value": "48px" },
    "16": { "value": "64px" },
    "20": { "value": "80px", "role": "The gap between top-level regions." }
  },

  "layout": {
    "measure":   { "value": "68ch", "role": "Maximum line length for prose. Wider than this and the eye loses the line." },
    "panel-max": { "value": "640px", "role": "The widest a single panel should grow in the workspace column." },
    "rail-width":{ "value": "336px", "role": "The hero rail: the herd and the readout summary." },
    "shell-max": { "value": "1440px", "role": "The widest the whole shell should grow before it just adds margin." },
    "tap":       { "value": "44px", "role": "The minimum comfortable touch target." }
  },

  "breakpoint": {
    "rule": { "value": "media queries cannot read var(), so these are the documented literals; app.css repeats them with the token named in a comment." },
    "tablet":  { "value": "720px", "role": "Below this: one column, bottom-sheet overlay, stacked readouts." },
    "desktop": { "value": "1100px", "role": "Above this: two columns and the sticky hero rail." }
  },

  "radius": {
    "none": { "value": "0" },
    "sm":   { "value": "4px" },
    "md":   { "value": "8px" },
    "lg":   { "value": "12px" },
    "xl":   { "value": "16px" },
    "2xl":  { "value": "20px", "role": "The overlay sheet: the largest radius in the system." },
    "pill": { "value": "999px" }
  },

  "elevation": {
    "0": { "value": "none", "role": "Flat. Most surfaces." },
    "1": { "value": "0 1px 2px rgba(22,22,22,0.06), 0 1px 1px rgba(22,22,22,0.04)", "role": "Cards at rest." },
    "2": { "value": "0 4px 12px rgba(22,22,22,0.08), 0 1px 3px rgba(22,22,22,0.06)", "role": "The approval card, and anything that must sit above the workspace." },
    "3": { "value": "0 12px 32px rgba(22,22,22,0.14)", "role": "Modals and overlays." },
    "4": { "value": "0 24px 64px rgba(22,22,22,0.20)", "role": "The mobile bottom sheet." }
  },

  "focus": {
    "width":  { "value": "2px" },
    "offset": { "value": "2px", "role": "One focus treatment for the whole interface. ring colour is semantic.border.focus." }
  },

  "layers": {
    "base":    { "value": "0" },
    "header":  { "value": "10" },
    "rail":    { "value": "20" },
    "scrim":   { "value": "40" },
    "overlay": { "value": "50" },
    "toast":   { "value": "60" }
  },

  "motion": {
    "duration": {
      "instant":  { "value": "90ms", "role": "Acknowledge: press, hover, focus. Must feel immediate." },
      "fast":     { "value": "140ms", "role": "Small feedback: chips, icons, inline validation." },
      "standard": { "value": "200ms", "role": "Component transitions." },
      "settle":   { "value": "260ms", "role": "The signature: panels and results settle in." },
      "slow":     { "value": "320ms", "role": "Larger component transitions." },
      "panel":    { "value": "380ms", "role": "Panel and page transitions." },
      "ambient":  { "value": "4500ms", "role": "Breathing. The herd at rest. Deliberately below the 4-6s BRAND.md sets." }
    },
    "easing": {
      "standard":  { "value": "cubic-bezier(0.2, 0, 0.2, 1)" },
      "entrance":  { "value": "cubic-bezier(0.05, 0.7, 0.1, 1)" },
      "exit":      { "value": "cubic-bezier(0.3, 0, 0.8, 0.15)" },
      "attention": { "value": "cubic-bezier(0.2, 0.9, 0.15, 1)", "role": "The 'needs you' arrival. Asymmetric on purpose." },
      "settle":    { "value": "cubic-bezier(0.22, 1, 0.36, 1)", "role": "A gentle settling spring. Decelerates hard, never overshoots into a bounce." }
    },
    "rule": {
      "value": "Bossa nova: everything moves slowly and never rushes. Only 'needs you' is allowed to be asymmetrical.",
      "source": "BRAND.md section 5"
    }
  }
